import java.util.Scanner;

public class RegistroEdades {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        int edadMayor = Integer.MIN_VALUE;
        int edadMenor = Integer.MAX_VALUE;
        int mayoresDeEdad = 0;
        int menoresDeEdad = 0;

        System.out.println("Ingrese las edades de 15 personas:");
        for (int i = 1; i <= 15; i++) {
            System.out.print("Edad " + i + ": ");
            int edad = scanner.nextInt();

            if (edad > edadMayor) {
                edadMayor = edad;
            }
            if (edad < edadMenor) {
                edadMenor = edad;
            }

            if (edad >= 18) {
                mayoresDeEdad++;
            } else {
                menoresDeEdad++;
            }
        }

        System.out.println("\nJava");
        System.out.println("Edad mayor: " + edadMayor);
        System.out.println("Edad menor: " + edadMenor);
        System.out.println("Mayores de edad: " + mayoresDeEdad);
        System.out.println("Menores de edad: " + menoresDeEdad);

        scanner.close();
    }
}
